# ============================================================================
# Humanity First Initiative — environment configuration
# Copy to .env.local and fill in. Anything left blank degrades gracefully:
# - no payment keys  -> donate page shows the "donor follow-up" form
# - no email keys     -> emails are skipped (logged), nothing breaks
# - no contact/org    -> those blocks simply don't render
# ============================================================================

# ── Core ────────────────────────────────────────────────────────────────────
# Neon / Postgres connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# Public site origin. REQUIRED in production — payment callbacks, canonical
# URLs, sitemap, and OG tags are built from this. Without it everything falls
# back to http://localhost:3000 and live checkout will redirect donors to localhost.
NEXT_PUBLIC_SITE_URL=https://your-domain.org

# ── Admin & staff access ────────────────────────────────────────────────────
ADMIN_TOKEN=use-a-long-random-secret
INSTRUCTOR_INVITE_CODE=change-this-private-instructor-code

# ── Payments: Flutterwave (NGN) ─────────────────────────────────────────────
# Set the secret key to enable live NGN checkout. The secret hash secures the webhook.
FLW_SECRET_KEY=
FLW_SECRET_HASH=

# ── Payments: PayPal (USD) ──────────────────────────────────────────────────
# Set client id + secret to enable USD checkout. Use PAYPAL_ENV=live in production.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
# Optional: reuse a fixed PayPal catalog product for recurring donations.
# If blank, a product is created automatically the first time it's needed.
PAYPAL_PRODUCT_ID=

# ── Email (Resend HTTP API) ─────────────────────────────────────────────────
# Set RESEND_API_KEY to enable donor receipts + team notifications.
# EMAIL_FROM must be a verified sender/domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=Humanity First Initiative <noreply@your-domain.org>
# Where new-donation / inquiry / submission alerts are sent (can be comma-separated).
ADMIN_NOTIFICATION_EMAIL=team@your-domain.org

# ── Analytics (optional, privacy-friendly) ──────────────────────────────────
# Set to your domain to enable cookieless Plausible analytics. Blank = no script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Public contact + organisation details ───────────────────────────────────
# Rendered in the footer / contact page only when set. Leave blank to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_ORG_REGISTRATION=
NEXT_PUBLIC_ORG_COUNTRY=
# Optional social profile URLs (blank = hidden).
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_X=

# ── Sib private screening (pay-per-view) ────────────────────────────────────
SIB_SCREENING_PASSWORD=change-this-screening-password
SIB_SCREENING_VIDEO_URL=https://example.com/path/to/private-screening-video.mp4
SIB_SCREENING_PAYMENT_URL=https://example.com/checkout-or-payment-link
SIB_SCREENING_SUPPORT_URL=/get-involved
SIB_SCREENING_ACCESS_HOURS=48
